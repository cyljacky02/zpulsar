<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  zPulsar ships elevated and DPI-aware.

  requireAdministrator: the ETW controlling APIs (StartTrace/ControlTrace) need
  it, and startup is fail-fast with no degraded mode (ADR-0002) — so asking for
  elevation at launch beats starting, failing, and explaining why.

  PerMonitorV2: the main window is created and destroyed repeatedly over one
  process lifetime (the Tray-idle cycle) and may come back on a different
  monitor at a different scale.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity type="win32" name="zPulsar" version="1.0.0.0" processorArchitecture="*"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11: without this the OS lies about its version. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
